  "scratch_adapter_sources": {
    ".scratch/run_guardian_manifest.py": "\"\"\"Observe the existing ESPN adapter without editing its protected module.\n\nIts staticmethod caches apply_xbe before the observer installs module wrappers.\nOnly forward that alias at call time; run the original test and assertions.\nNo writer output, changed-byte attribution or reservation check is replaced.\n\"\"\"\nfrom pathlib import Path\nimport runpy\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\nfrom mod_editor.core import nfl2k5_espn25_rosters as espn\nespn.XbePatch.apply = staticmethod(lambda payload: espn.apply_xbe(payload))\nrunpy.run_path('tests/mod_editor/test_nfl2k5_guardian_manifest.py', run_name='__main__')\n",
    ".scratch/run_read_option_manifest.py": "\"\"\"Supply the documented scratch manifest to an older test's fixed default.\n\nThe test and every assertion run unchanged. It imports DEFAULT_MANIFEST\ndirectly and does not implement NFL2K5_CAVE_MANIFEST itself.\n\"\"\"\nimport os\nfrom pathlib import Path\nimport runpy\nimport sys\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\nfrom mod_editor.core import nfl2k5_cave_oracle as oracle\noracle.DEFAULT_MANIFEST = Path(os.environ['NFL2K5_CAVE_MANIFEST']).resolve()\nrunpy.run_path('tests/mod_editor/test_nfl2k5_read_option_diagnostic_manifest.py', run_name='__main__')\n"
