  "separation": {
    "overall": "Derived and rounded from position-specific formula tables; never stored or written as a base rating.",
    "abilities": "Separate packed bits around player offsets 0x18 through 0x2C; not inferred from base-rating values.",
    "star_tier": "Gold, Silver, and Bronze storage is not mapped and must not be inferred from ratings or ability count.",
    "runtime_modifiers": "Effective getters may apply a per-attribute multiplier when player +0x20 high bits are set; its fatigue, injury, boost, or tier semantics remain unresolved.",
    "global_sliders": "Difficulty and gameplay sliders are separate systems and are not player ratings."
  },
  "runtime": {
    "status": "token_preserving_runtime_loaded",
    "reason": "A token-preserving ROST build changed Dan Marino's stored Speed byte from 40 to 99, booted in Xenia, and loaded/rendered the edited player record without the former startup crash. The desktop editor therefore exposes semantic per-attribute replacement under a strict public 0..99 authoring limit. A source value of native 100 is still displayed exactly and can be reverted, but the product does not author new 100 values. The game has no numeric ratings screen, so the isolated on-field effect of each attribute remains a separate gameplay-validation question."
  },
  "public_distribution": {
    "contains_retail_bytes": false,
    "contains_player_values": false,
    "metadata_contents": "field names, integer offsets, scale contracts, and findings only"
  },
  "label_provenance": {
    "xex_descriptor_proved": "The executable's attribute descriptor table at 0x820E4D94 (27 records, stride 0x60) holds this display name at +0x0C, its 3-letter UI abbreviation at +0x00, and a pointer at +0x18 to this attribute's own setter. That setter's stb displacement names the byte, so the name-to-byte pairing is read from the executable rather than inferred.",
    "neutral_unresolved": "An editable, position-proved byte the descriptor table does not name. No guess is adopted.",
    "superseded_evidence": "APFe's SFLSettings.csv row ORDER is the record's byte order -- under the identity mapping 11 slots reproduce all 61 stock Gold players exactly across 17 positions -- but its row NAMES are misassigned in the tail, and its Attributes panel disagrees with its own CSV on three of the passing attributes. Neither APFe artifact is used for naming. See docs/research/apf_rating_slot_settlement.md."
  },
  "value_domains": {
    "rating_0_99": "An ordinary rating. Any exact integer 0..99 is authorable.",
    "quantized_axis": "Numeric, but stock uses only a few widely separated values that the game surfaces as named buckets. Intermediate values are unobserved and unproved.",
    "enumerated": "A small set of index values, not a magnitude. Writing a value outside observed_stock_values is unproved and may be invalid.",
    "constant": "Every populated stock record holds the same value. Editing it has no demonstrated effect and no name is derivable from the data.",
    "measured_over": "1,437 stock player records with a populated 0xBA..0xD9 block, read from the supported USA disc."
  }
