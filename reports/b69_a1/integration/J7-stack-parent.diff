+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 220,
+    "text": "Deep-ball ceiling in yards"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 225,
+    "text": " yd"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 229,
+    "text": "55 is the original. The curve is re-spaced as a scale: at 80, a 70 arm throws 41, an 85 arm 52, a 95 arm 66, a 99 arm 80 (original 40 / 45 / 50 / 55)."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 232,
+    "text": "throwMuted"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 242,
+    "text": "Pass arc percentage"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 247,
+    "text": " %"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 251,
+    "text": "0 leaves the original speed table alone (deep balls fly at 20 yd/s and hang about 2.75 s at 55 yards). Higher values slow the ball past the last 25 yards of the ceiling so it hangs longer and climbs higher; 40 % at an 80-yard ceiling is a 5.0 s, 33-yard-high bomb. Realistic deep-ball flight overrides this arc."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 256,
+    "text": "throwMuted"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 259,
+    "text": "Realistic deep-ball flight (recommended)"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 261,
+    "text": "Replaces the arc slider with the speed table elite NFL arms actually produce: ~60 mph release, 3.2-3.9 s hang for 60-80 air yards, apex 13-20 yd. Short game stays retail."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 265,
+    "text": "Arc by distance: 45-60 yd lobs hang high, 63+ yd keep the flat bomb"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 267,
+    "text": "Relocates the lob-speed table to an eight-point copy in the XBE header: every throw up to 40 yards keeps the retail speeds (short accuracy and power unchanged), 45 to 60 air yards get the high hanging arc (12 yd/s ground speed), 63 yards and beyond keep the realistic flat flight. The in-place table then only matters for read-back; the ceiling still applies."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 273,
+    "text": "Flight arc: flatter deep ball (EXPERIMENTAL / UNWITNESSED)"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 277,
+    "text": "Real deep balls are not moon balls: the longest tracked NFL completions (62-68 air yards) hang about 3.5 s with an apex near 15 yd. This table gives 55 yd \u2192 2.8 s, 65 \u2192 3.2 s, 80 \u2192 3.8 s (apex 19 yd)."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 281,
+    "text": "throwMuted"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 283,
+    "text": "Details"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 290,
+    "text": "Also include (same changes as \u2605 Build & Share)"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 291,
+    "text": "These apply to the copy made on this page only; the Build tab keeps its own selection."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 292,
+    "text": "throwMuted"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 298,
+    "text": "Fix Catching && Interception sliders"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 300,
+    "text": "Retail: the Catching slider barely reaches play. This 60-byte executable patch divides the catch roll by twice the receiver's side's slider: 50 = retail, 100 = double the catch odds, 200 = quadruple. Raises both Catching menu ceilings to 200. xemu-only."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 306,
+    "text": "Modern ESPN scorebar (full disc required)"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 308,
+    "text": "Re-lays the field scorebug mesh into one bar (ESPN mark, away/home abbreviations and scores, down & distance, quarter, clock, play clock), pins all three placement modes to the bottom centre above the ticker band, freezes the drop-box animations, and repaints the frame atlas and ESPN strip. Needs a disc image because the mesh lives in the field resource pack. xemu-only."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 315,
+    "text": "Gradual player acceleration"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 317,
+    "text": "EXPERIMENTAL / UNWITNESSED. Retail already has acceleration. This older option adds a gradual change to the effective Speed rating. It compounds native acceleration and does not treat human and CPU steering alike. This is separate from the slow-QB carrier curve."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 323,
+    "text": "Smarter Franchise drafts && free agency"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 325,
+    "text": "Retail CPU teams draft the best raw overall at their neediest positions (so the positions whose rookies roll the highest overalls flood round 1) and chase free agents in position-enum order. This executable patch picks by each prospect's edge over his own position's class, real positional value, the team's need order and a little noise, and scores free-agent targets the same way. Fantasy draft untouched. xemu-only."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 332,
+    "text": "Fix CPU kick && punt returners"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 334,
+    "text": "The franchise auto depth chart never records which player had the best punt-return score: it stores the score itself as the roster slot, so the punt returner is whoever sits in slot 0 (often a QB), and the second kick returner is picked with a stale score. This executable patch tracks the players, scans the whole roster, keeps starters out unless nobody else is eligible, and limits returners to WR/CB/S/RB/FB. xemu-only."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 341,
+    "text": "Change player growth && decline"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 343,
+    "text": "Retail development is a hidden archetype per player driving flat curves (+2 or +3 from rookie year to the prime). This data patch reshapes the ten aging-curve tables (growth over years 1-5 by rating family, steeper decline after year 9-12, speed first) and widens the archetype mix per position so more prospects become stars or busts. Draft-day ratings are unchanged. xemu-only."
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 350,
+    "text": "Call defensive ends EDGE"
+  },
+  {
+    "file": "mod_editor/gui/throw_tuning_panel_qt.py",
+    "line": 352,
+    "text": "Repoints the five position-abbreviation tables and the play-call Package legend to a new EDGE string hosted in the XBE header, shrinks the 18 'Defensive End(s)' long names to 'Edge Rusher(s)' in place, relabels the LDE/RDE formation slots EDGE (LEFT/RIGHT EDGE RUSHER), and on a disc image renames the 247 historic-team 'Def End' players to 'Edge' and two trivia questions. Pattern-checked, digests recomputed. xemu-only."
+  },
+  {
