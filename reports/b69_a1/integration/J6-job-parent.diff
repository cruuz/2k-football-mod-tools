+        decoded, _ = self.source._probe.decode_resource(before,resource)
+        bad = bytearray(decoded); bad[0x20] ^= 1
+        packed, _ = M._tools_module('nfl_vc_lz_fill').rebuild_fixed_span_filled(before,bytes(bad),encoder='auto')
