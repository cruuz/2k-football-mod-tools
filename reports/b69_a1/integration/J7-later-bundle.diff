index e938078b..7b5dcd6e 100644
--- a/mod_editor/gui/polish_qt.py
+++ b/mod_editor/gui/polish_qt.py
@@ -4,11 +4,35 @@ Specific page help always wins. These defaults expose existing labels and help
 on keyboard controls too, and keep text buttons readable inside scrolling pages.
 """
 from __future__ import annotations
+from PyQt5.QtCore import QUrl
+from PyQt5.QtGui import QDesktopServices
 from PyQt5.QtWidgets import (
     QAbstractButton, QAbstractSpinBox, QCheckBox, QComboBox, QFormLayout,
-    QGridLayout, QLabel, QLineEdit, QPushButton, QToolButton, QTabWidget, QWidget,
+    QGridLayout, QLabel, QLineEdit, QMessageBox, QPushButton, QToolButton, QTabWidget, QWidget,
 )
 
+
+def open_in_desktop(parent: QWidget | None, url: QUrl) -> bool:
+    """Leave a usable address when the browser or file handler cannot open it."""
+    if QDesktopServices.openUrl(url):
+        return True
+    if url.isLocalFile():
+        title = "Could not open the file or folder"
+        message = (
+            "Your computer did not open this location. Copy the path below into "
+            "your file manager, then open the file or folder there:\n\n"
+            + url.toLocalFile()
+        )
+    else:
+        title = "Could not open the web page"
+        message = (
+            "Your computer did not open this address. Copy it into your browser "
+            "to continue:\n\n" + url.toString()
+        )
+    QMessageBox.information(parent, title, message)
+    return False
+
+
 def _field_label(widget: QWidget) -> str:
     if widget.accessibleName():
         return widget.accessibleName()
