+     uc.reg_write(EAX,value);uc.reg_write(EIP,t.words(esp)[0]);uc.reg_write(ESP,esp+pop)
+    for address in (0x437d0,0x48700,0x48ff0,0x430e0,0x48760,0x43e30,0x43e10):
