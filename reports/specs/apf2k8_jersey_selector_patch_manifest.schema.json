  "title": "APF 2K8 jersey selector patch manifest",
  "type": "object",
  "x-semantic-validations": [
    {
      "id": "canonical_json_bytes",
      "rule": "1..2097152 bytes containing a UTF-8 JSON object, duplicate keys rejected, finite JSON numbers only, serialized as json.dumps(value, indent=2, sort_keys=True) followed by one LF"
    },
    {
      "id": "assignment_derivation",
      "rule": "assignments are unique and strictly increasing by team_index; team_name, expected retail asset, and both bank_selector_record_indices equal the pointer-derived retail reference for that team; changed equals replacement_asset_index != expected_retail_asset_index"
    },
    {
      "id": "recipe_binding",
      "rule": "recipe assignment_count, mode, SHA-256, and size exactly describe the separately supplied canonical recipe"
    },
    {
      "id": "compression_arithmetic",
      "rule": "payload_size_after + headroom_bytes_after = 436024; retail_tokens_preserved_semantically + retail_tokens_split_or_replaced = 284015; file_length_after = 84 + 20 + payload_size_after; output_zero_tail_bytes = 436224 - file_length_after - 96 and therefore equals headroom_bytes_after"
    },
    {
      "id": "compression_rederivation",
      "rule": "payload SHA-256, output token count, semantic preservation counts, and rebuilt outer-entry SHA-256 are independently recomputed from the output bytes using the format specification"
    },
    {
      "id": "decoded_preservation",
      "rule": "authorized_decoded_byte_count = 2 * recipe.assignment_count; decoded_changed_byte_count = 2 * count(assignments where changed); only the two pointer-derived selector byte-0 offsets per assigned team may differ from retail; decoded_output_sha256 is recomputed"
    },
    {
      "id": "claim_derivation",
      "rule": "all_24_built_in_teams_mutually_unique_offline is true exactly when the complete post-recipe built-in asset vector has 24 distinct values; no runtime, hardware, GUI, opaque-byte, all-40-slot, or archive-growth claim may be inferred"
    },
    {
      "id": "complete_volume_binding",
      "rule": "copied_volume.name equals the output path basename; size and SHA-256 are recomputed over the bound output; prefix [0,47699968) and suffix [48136192,1140850688) equal the pinned retail source byte-for-byte"
    },
    {
      "id": "format_authority_binding",
      "rule": "source.format_spec_sha256 and source.format_spec_size_bytes identify the exact checked format specification used for the build"
    }
  ]
