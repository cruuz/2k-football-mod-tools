      "summary": "The Fable broadcast design's colours on the game's fixed cells: a near-black body, dark team blocks, a red down banner over a light clock strip.",
      "note": "The Fable design's own cell geometry cannot fit the fixed atlas, so this preset carries its palette and shapes with the reference mark, not its exact pixels.",
      "layers": {
        "frame": {"fill": "#101217FF", "gradient": {"stops": ["#1B1F27FF", "#0E1015FF"], "angle": 90}, "radius": 1, "border": {"colour": "#2C313AFF", "width": 1}, "opacity": 100, "image": null, "sample_text": null},
        "left_mark": {"fill": "#00000000", "gradient": null, "radius": 0, "border": null, "opacity": 100, "image": {"fit": "tile", "clip": false, "crop": null, "name": "left_mark.png", "sources": [{"scale": "1x", "file": "docs/scorebug_template/1x/left_mark.png"}, {"scale": "2x", "file": "docs/scorebug_template/2x/left_mark.png"}]}, "sample_text": null},
