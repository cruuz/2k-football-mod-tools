{
  "schema": "nfl2k5_scorebug_studio_presets/v1",
  "note": "Scorebar Studio presets. A 'folder' preset opens any valid nfl2k5_scorebug_template/v1 folder as picture layers; add one with a JSON row only. A 'paint' preset is simple colours, blends, rounding and borders for the eight fixed cells, with optional pictures listed by repository-relative path. Colours are #RRGGBBAA. Blend angle 0 runs left to right and 90 top to bottom. Rounding and border widths are atlas tile pixels.",
  "presets": [
    {
      "id": "reference_v10",
      "title": "Reference (v10)",
      "kind": "folder",
      "folder": "docs/scorebug_template",
      "summary": "The shipped repaintable ESPN scorebar. Every part opens as a picture you can keep or replace.",
      "note": "Saving it back unchanged is pixel for pixel identical. Choose Use colours instead on a part to repaint it with the controls."
    },
    {
      "id": "fable_espn",
