 "experimental": true,
 "witnessed": false,
 "table": {
  "va": "0x4E7FE0",
  "stride": 28,
  "entries": 80,
  "fields": {
   "+0": "asset code string pointer (kept)",
   "+4": "float scale of the menu background colour",
   "+8": "primary (ARGB)",
   "+0xC": "secondary",
   "+0x10": "u16: menu background uses the secondary",
   "+0x12": "u16: 0x68EB0 returns the secondary (the darker slot)",
   "+0x14": "accent",
   "+0x18": "translucent background"
  },
  "readers": [
   "0x68D70 primary",
   "0x68DC0 secondary",
   "0x68E10 accent",
   "0x68E60 background",
   "0x68EB0/0x68F10 darker/lighter",
   "0x6B5B0 menu background (0x6BF70 Menubackground)"
  ]
 },
 "palette": "data/nfl2k5_scorebug_sprite/team_colors_official_2026.json (2026 Record and Fact Book, NFL.com club logo files)",
 "rules": "Slots take the 2026 primary and secondary (pure black written as retail's near-black 0x101010), except that a bright primary (brightest channel above 160) with a clearly darker secondary (by 40) swaps into the secondary slot, so the in-game scorebar (scorebar v3 reads the direct primary for its panel) keeps a dark panel: Falcons, Panthers, Bengals, Broncos, Saints, Raiders, Buccaneers. +0x12 = the secondary is darker. The menu background is the primary, or the secondary when the primary is white, silver or grey (or after a dark-primary swap), at retail's brightness band (black x4.5, dark lifted to lum 45 at most x1.75, light darkened to lum 105); a swap flips +0x10 and +0x12, so every menu getter returns the same colour. Accent: equal to a slot follows the slot; otherwise the nearest-hue 2026 colour at the retail luminance. Background +0x18: retail neutrals kept, else the nearest-hue 2026 colour, never brighter than retail.",
